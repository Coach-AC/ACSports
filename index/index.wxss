.container {
  padding: 30rpx;
  text-align: center;
}

.logo {
  width: 200rpx;
  height: 200rpx;
  margin: 40rpx auto 20rpx auto;
}

.company-name {
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.brand {
  font-weight: bold;
  color: #1aad19;
}

.intro {
  font-size: 24rpx;
  color: #555;
  margin-bottom: 40rpx;
  padding: 0 20rpx;
}

.menu {
  display: flex;
  flex-direction: column;
  gap: 25rpx;
}

.menu-item {
  background-color: #f5f5f5;
  padding: 30rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.menu-item:active {
  background-color: #e0e0e0;
}

.icon {
  font-size: 40rpx;
}